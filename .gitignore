# Local env
.env
.env.*
!.env.example
# Blender sources & backups: kept locally only. CI builds `dist/` from
# `public/models/*.glb`, so `.blend` sources are not needed in the repo and
# would add ~128 MB of binary weight.
blender/source/*.blend
blender/source/*.blend1
*.blend1
__pycache__/
*.pyc
